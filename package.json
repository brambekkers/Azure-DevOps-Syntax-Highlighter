{
  "name": "azure-syntax-highlighting",
  "displayName": "Azure DevOps Syntax Highlighter",
  "version": "1.0.15",
  "author": "Bram Bekkers",
  "description": "Adds syntax highlighting to code diffs in Azure DevOps pull request reviews",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "azure-devops",
    "syntax-highlighting",
    "pull-request",
    "code-review"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fmt": "prettier --write '**/*.{ts,json,css,scss,md}'",
    "zip": "npm run build && node src/zip.js"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.23",
    "@types/chrome": "^0.0.246",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-kaioken": "^0.12.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "kaioken": "^0.30.1"
  }
}
